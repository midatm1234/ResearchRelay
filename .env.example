# Default shared knowledge: ResearchRelay repository, SRTD_DT_test branch.
# This mode retrieves committed project knowledge; it never publishes on startup.
RESEARCHRELAY_MODE=live
RESEARCHRELAY_PROJECT=agentic-collaboration
RESEARCHRELAY_DB=.runtime/literature/state.db
RESEARCHRELAY_REPO=.runtime/literature/project-record
RESEARCHRELAY_GITHUB_URL=git@github.com:midatm1234/ResearchRelay.git
RESEARCHRELAY_GITHUB_BRANCH=SRTD_DT_test
RESEARCHRELAY_KNOWLEDGE_PATH=projects/agentic-collaboration
RESEARCHRELAY_SYNC_INTERVAL=15
# Users/teams can choose their own GitHub URL, branch, and knowledge directory.
# A repository saved through Configure repository/API takes precedence on restart.
# Set RESEARCHRELAY_GITHUB_URL explicitly blank to disable only the environment fallback.
# Existing saved bindings are preserved; blank does not erase a team's choice.
# Another project/group should use its own project ID, database, and record path.

# For authenticated team access, use a private network/TLS proxy and random tokens.
# Mapping token -> participant. "human" has coordination privileges.
RESEARCHRELAY_TOKENS={}
# Example (replace values, never commit .env):
# RESEARCHRELAY_TOKENS={"random-human-secret":"human","random-alice-secret":"alice","random-bob-secret":"bob"}
# Git credentials stay in this host's SSH agent/credential manager.
# Provider/editor credentials stay in EACH participant's own environment.

# Draft-PR base is separate from the knowledge branch.
RESEARCHRELAY_GITHUB_BASE=main

# Credential-free local demonstration uses isolated offline state:
# researchrelay serve --offline-demo
# researchrelay demo --offline
# Optional --db and --repo select a fresh offline workspace.
