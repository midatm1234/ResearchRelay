{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ResearchRelay: service",
      "type": "debugpy",
      "request": "launch",
      "module": "researchrelay",
      "args": [
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }
  ]
}
