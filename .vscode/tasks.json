{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ResearchRelay: serve (stops when window closes)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\researchrelay.ps1\" run",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "ResearchRelay: start service",
      "args": [
        "-m",
        "researchrelay",
        "serve"
      ],
      "isBackground": true,
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "ResearchRelay: start offline demo service",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "researchrelay",
        "serve",
        "--offline-demo"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "ResearchRelay: run offline literature demo",
      "args": [
        "-m",
        "researchrelay",
        "demo",
        "--offline"
      ],
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "ResearchRelay: test",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "group": "test",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "ResearchRelay: configure editor agent",
      "args": [
        "-m",
        "researchrelay",
        "agent",
        "configure",
        "--provider",
        "vscode"
      ],
      "options": {
        "env": {
          "RESEARCHRELAY_TOKEN": "${input:participantToken}"
        },
        "cwd": "${workspaceFolder}"
      },
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "problemMatcher": []
    },
    {
      "label": "ResearchRelay: editor worker",
      "args": [
        "-m",
        "researchrelay",
        "worker",
        "--participant",
        "${input:participant}",
        "--repo",
        "${workspaceFolder}/.runtime/${input:participant}-clone",
        "--provider",
        "vscode",
        "--once",
        "--timeout",
        "3600"
      ],
      "options": {
        "env": {
          "RESEARCHRELAY_TOKEN": "${input:participantToken}"
        },
        "cwd": "${workspaceFolder}"
      },
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "participant",
      "type": "promptString",
      "description": "Assigned participant identity",
      "default": "alice"
    },
    {
      "id": "participantToken",
      "type": "promptString",
      "description": "Your private ResearchRelay participant token (never saved in this file)",
      "password": true
    }
  ]
}
